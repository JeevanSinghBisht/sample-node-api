# Copy to .env and adjust: cp .env.example .env
# GitLab-only workflow — no GitHub account or webhooks required.

# --- Shared platform auth (registry + cursor-bridge internal APIs + n8n HMAC nodes) ---
PLATFORM_INTERNAL_HMAC_SECRET=local-dev-secret

# --- MySQL (host install OR docker compose --profile infra) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=platform
MYSQL_PASSWORD=platform

# --- Redis (host OR compose --profile infra) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ (host OR compose --profile infra) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=platform

# --- GitLab product repo (what Cursor agents clone and modify) ---
AGENT_REPO_URL=https://gitlab.com/your-group/your-product
GITLAB_PROJECT_PATH=your-group/your-product
REPO_DEFAULT_REF=main

# --- workflow-registry (host :8081) ---
# Leave empty — GitLab manual workflow does not use GitHub webhooks.
GITHUB_WEBHOOK_SECRET=
N8N_TASK_STATE_WEBHOOK_URL=http://localhost:5678/webhook/platform-task-state
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173
# workflow-registry → cursor-bridge (dashboard Run developer/reviewer/tester)
BRIDGE_BASE_URL=http://localhost:8082
# Required on workflow-registry when using dashboard actions (loaded via scripts/run-registry.sh)
AGENT_REPO_URL=https://gitlab.com/your-group/your-product
REPO_DEFAULT_REF=main

# --- cursor-bridge (host :8082) ---
REGISTRY_BASE_URL=http://localhost:8081
CURSOR_API_KEY=
CURSOR_MOCK_ENABLED=true
# Optional explicit Cloud Agent model id (must appear in GET https://api.cursor.com/v1/models).
# Leave unset to use your Cursor account default model.
# CURSOR_DEFAULT_MODEL_ID=
PLATFORM_COMPLETION_WEBHOOK_SECRET=
N8N_AGENT_COMPLETION_WEBHOOK_URL=http://localhost:5678/webhook/platform-agent-completion

# --- n8n (docker compose service: n8n, UI http://localhost:5678) ---
N8N_REGISTRY_BASE_URL=http://host.docker.internal:8081
N8N_BRIDGE_BASE_URL=http://host.docker.internal:8082

# --- ops-dashboard (Vite dev :5173) ---
VITE_REGISTRY_URL=
