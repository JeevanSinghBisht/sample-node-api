# Copy to .env and adjust: cp .env.example .env
# Used by: docker compose (n8n), and as reference for Spring / Vite on the host.

# --- Shared platform auth (registry + cursor-bridge internal APIs + n8n HMAC nodes) ---
PLATFORM_INTERNAL_HMAC_SECRET=local-dev-secret

# --- MySQL (docker compose service: mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=platform
MYSQL_PASSWORD=platform

# --- Redis (docker compose service: redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ (docker compose service: rabbitmq) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=platform

# --- workflow-registry (host :8081) ---
GITHUB_WEBHOOK_SECRET=
# After importing n8n workflows and activating them (see platform/n8n/README.md):
N8N_TASK_STATE_WEBHOOK_URL=http://localhost:5678/webhook/platform-task-state
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173

# --- cursor-bridge (host :8082) ---
REGISTRY_BASE_URL=http://localhost:8081
CURSOR_API_KEY=
CURSOR_MOCK_ENABLED=true
PLATFORM_COMPLETION_WEBHOOK_SECRET=
N8N_AGENT_COMPLETION_WEBHOOK_URL=http://localhost:5678/webhook/platform-agent-completion

# --- n8n (docker compose service: n8n, UI http://localhost:5678) ---
# Workflows read these via $env in Code nodes (requires N8N_BLOCK_ENV_ACCESS_IN_NODE=false in compose).
GITHUB_REPO_URL=https://github.com/your-org/your-repo
# From inside the n8n container, Spring apps on the host are reached via host.docker.internal:
N8N_REGISTRY_BASE_URL=http://host.docker.internal:8081
N8N_BRIDGE_BASE_URL=http://host.docker.internal:8082

# --- ops-dashboard (Vite dev :5173) ---
# Leave empty to use vite proxy to localhost:8081; set for production builds.
VITE_REGISTRY_URL=
