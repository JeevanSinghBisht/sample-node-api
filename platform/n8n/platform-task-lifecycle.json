      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "platform-task-state"
    },
    {
      "parameters": {
        "jsCode": "const envelope = $json.body ?? $json;\nconst payload = envelope.payload ?? envelope;\nreturn [{ json: {\n  taskId: payload.taskId,\n  state: payload.state,\n  repoFullName: payload.repoFullName,\n  issueNumber: payload.issueNumber,\n  issueUrl: payload.issueUrl,\n  issueTitle: payload.issueTitle,\n  issueBody: payload.issueBody,\n  prUrl: payload.prUrl,\n  headSha: payload.headSha,\n  attemptDev: payload.attemptDev ?? 0,\n  attemptReview: payload.attemptReview ?? 0,\n  attemptQa: payload.attemptQa ?? 0\n}}];"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000002",
      "name": "Normalize envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "READY",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "READY"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "IN_REVIEW",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "IN_REVIEW"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "IN_QA",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "IN_QA"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000003",
      "name": "Switch on state",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst taskId = $('Normalize envelope').item.json.taskId;\nconst secret = $env.PLATFORM_HMAC_SECRET;\nconst body = JSON.stringify({ role: 'DEVELOPER', n8nExecutionId: $execution.id });\nconst ts = Math.floor(Date.now()/1000).toString();\nconst sigPayload = ts + '.' + body;\nconst sig = 'hmac-sha256=' + crypto.createHmac('sha256', secret).update(sigPayload).digest('hex');\nreturn [{ json: { taskId, body, ts, sig } }];"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000010",
      "name": "HMAC create execution DEV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 140]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.REGISTRY_BASE_URL }}/internal/v1/tasks/{{ $json.taskId }}/executions",
